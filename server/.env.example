# GigaChat (Sber) - тот же ключ, что и в других проектах, или отдельный
GIGACHAT_AUTH_KEY=

# Telegram-бот (создать через @BotFather)
TELEGRAM_BOT_TOKEN=

# Yandex SpeechKit (Yandex Cloud -> сервис SpeechKit -> API-ключ)
YANDEX_SPEECHKIT_API_KEY=
YANDEX_FOLDER_ID=

# Supabase-проект (Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Hugging Face Inference API - бесплатный аккаунт на huggingface.co,
# Settings -> Access Tokens -> New token (достаточно прав "Read")
HF_API_TOKEN=

# Публичный URL этого backend (нужен для Telegram webhook)
PUBLIC_URL=

PORT=3001
